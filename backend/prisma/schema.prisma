datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String    @default("interviewer")
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Settings {
  key   String @id
  value String
}

model Candidate {
  id                String    @id @default(cuid())
  name              String
  domainsAppliedFor String?   // Domains Applied For e.g. "Web Dev, AI/ML"
  branchAndSection  String?   // Branch & Section e.g. "CSE - A"
  domainInAAC       String?   // Domain in AAC e.g. "Computer Vision"
  cgpa              String?   // CGPA e.g. "8.75"
  currentAttendance String?   // Current Attendance e.g. "88%"
  role              String?
  department        String?
  email             String?
  notes             String?
  status            String    @default("not_started")
  createdAt         DateTime  @default(now())
  sessions          Session[]
}

model Question {
  id          String      @id @default(cuid())
  text        String
  category    String?
  description String?
  isCustom    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  recordings  Recording[]
}

model Session {
  id             String      @id @default(cuid())
  candidateId    String
  candidate      Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?       @relation(fields: [userId], references: [id])
  interviewer    String?     @default("Lead Interviewer")
  fullAudioUrl   String?     // Cloudinary URL for full continuous interview audio
  fullTranscript String?     // Complete continuous transcription text
  startedAt      DateTime    @default(now())
  status         String      @default("in_progress")
  recordings     Recording[]
}

model Recording {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  takeNumber      Int
  audioUrl        String?  // Cloudinary URL
  rawTranscript   String?
  cleanTranscript String?
  aiSummary       String?  // Concise AI summary of candidate answer
  keyPoints       String?  // Key bullet takeaways
  score           Float?   // Interviewer score rating (e.g. 8.5)
  comments        String?  // Interviewer feedback comments
  durationSec     Int?
  notes           String?
  isActive        Boolean  @default(true)
  recordedAt      DateTime @default(now())
}
