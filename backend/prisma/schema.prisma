datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String    @default("interviewer")
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Settings {
  key   String @id
  value String
}

model Candidate {
  id                String    @id @default(cuid())
  name              String
  domainsAppliedFor String?   // Domains Applied For e.g. "Web Dev, AI/ML"
  branchAndSection  String?   // Branch & Section e.g. "CSE - A"
  domainInAAC       String?   // Domain in AAC e.g. "Computer Vision"
  cgpa              String?   // CGPA e.g. "8.75"
  currentAttendance String?   // Current Attendance e.g. "88%"
  role              String?
  department        String?
  email             String?
  notes             String?
  status            String    @default("not_started")
  isFlagged         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  sessions          Session[]
}

model Question {
  id          String      @id @default(cuid())
  text        String
  category    String?
  description String?
  isCustom    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  recordings  Recording[]
}

model Session {
  id                String      @id @default(cuid())
  candidateId       String
  candidate         Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId            String?
  user              User?       @relation(fields: [userId], references: [id])
  interviewer       String?     @default("Lead Interviewer")
  fullAudioUrl      String?
  fullTranscript    String?
  startedAt         DateTime    @default(now())
  status            String      @default("in_progress")
  // Recording lock - which device ID currently holds the recording lock
  recordingLockDevice String?
  lockAcquiredAt    DateTime?
  // Processing state flags
  isTranscribing    Boolean     @default(false)
  isAnalyzing       Boolean     @default(false)
  transcriptionStatus String    @default("none")  // none | done | error
  analysisStatus    String      @default("none")  // none | done | error
  recordings        Recording[]
  audioClips        AudioClip[]
}

model AudioClip {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filePath    String   // Absolute local path on the server
  audioUrl    String   // LAN-accessible URL for playback on all devices
  durationSec Int?
  transcript  String?  // Populated after Transcribe is clicked
  status      String   @default("pending")  // pending | transcribing | done | error
  recordedAt  DateTime @default(now())
}

model Recording {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  takeNumber      Int
  audioUrl        String?
  rawTranscript   String?
  cleanTranscript String?
  aiSummary       String?
  keyPoints       String?
  score           Float?
  comments        String?
  durationSec     Int?
  notes           String?
  isActive        Boolean  @default(true)
  recordedAt      DateTime @default(now())
}
