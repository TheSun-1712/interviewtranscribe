datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  role      String    @default("interviewer") // admin | interviewer
  createdAt DateTime  @default(now())
  sessions  Session[]
}

model Settings {
  key   String @id
  value String
}

model Candidate {
  id          String    @id @default(cuid())
  name        String
  role        String?
  department  String?
  email       String?
  notes       String?
  status      String    @default("not_started") // not_started | in_progress | complete
  createdAt   DateTime  @default(now())
  sessions    Session[]
}

model Question {
  id          String      @id @default(cuid())
  text        String
  category    String?
  description String?
  isCustom    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  recordings  Recording[]
}

model Session {
  id          String      @id @default(cuid())
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?       @relation(fields: [userId], references: [id])
  interviewer String?     @default("Lead Interviewer")
  startedAt   DateTime    @default(now())
  status      String      @default("in_progress") // in_progress | complete
  recordings  Recording[]
}

model Recording {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  takeNumber      Int
  audioUrl        String?  // Cloudinary secure_url
  rawTranscript   String?
  cleanTranscript String?
  durationSec     Int?
  notes           String?
  isActive        Boolean  @default(true)
  recordedAt      DateTime @default(now())
}
